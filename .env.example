# Local access defaults to http://127.0.0.1:3000, with trading stopped.
PORT=3000
HOST=127.0.0.1

# Required for public/network access. Use a unique password of at least 16 characters.
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD=

# Optional local storage directory. Default: project folder.
# DATA_DIR=

# Railway: attach a volume; RAILWAY_VOLUME_MOUNT_PATH is supplied automatically.
# Set HOST=0.0.0.0 (or omit HOST on Railway). Let Railway supply PORT.
# HELIUS_API_KEY is not needed for this paper-trading application.
